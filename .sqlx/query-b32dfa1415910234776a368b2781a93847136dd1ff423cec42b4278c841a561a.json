  "query": "SELECT uploader_ip AS \"ip!: Vec<u8>\", CAST(COUNT(*) AS SIGNED) AS \"count!: i64\", CAST(AVG(nsfw_score) AS DOUBLE) AS \"avg_score!: f64\"\n           FROM uploads\n           WHERE deleted_timestamp IS NULL AND uploader_ip IS NOT NULL AND nsfw_score >= ?\n           GROUP BY uploader_ip\n           ORDER BY 2 DESC\n           LIMIT ?",
