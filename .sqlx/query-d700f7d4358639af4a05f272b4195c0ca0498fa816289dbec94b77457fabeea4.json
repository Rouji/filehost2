  "query": "SELECT uploader_ip AS \"ip!: u32\", CAST(COUNT(*) AS SIGNED) AS \"count!: i64\", CAST(COALESCE(SUM(file_size), 0) AS SIGNED) AS \"bytes!: i64\"\n           FROM uploads\n           WHERE deleted_timestamp IS NULL AND uploader_ip IS NOT NULL\n           GROUP BY uploader_ip\n           ORDER BY 2 DESC\n           LIMIT ?",
